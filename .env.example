# AERIS Environment Configuration Template
#
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# All variables prefixed VITE_ are exposed to the browser bundle.

# ─── Application Mode ──────────────────────────────────────────────────────────
# Controls whether AERIS uses live external APIs or deterministic demo data.
# DEMO mode requires zero external API keys and produces only SIMULATED data.
# REAL mode attempts live data and falls back to SIMULATED on failure.
# Valid values: DEMO | REAL
VITE_DATA_MODE=DEMO

# ─── API Base URL ──────────────────────────────────────────────────────────────
# Backend API Gateway base URL.
# Leave as /api for local development proxy.
VITE_API_BASE_URL=/api

# ─── External Data Sources (REAL mode only) ────────────────────────────────────
# OpenAQ: https://docs.openaq.org/
# No key needed for public endpoints – rate limits apply.
OPENAQ_API_KEY=

# OpenMeteo weather – free, no key required.
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1

# ─── AWS (backend Lambda only – never expose in frontend) ─────────────────────
AWS_REGION=us-east-1
AWS_PROFILE=default

# ─── Amazon Bedrock ────────────────────────────────────────────────────────────
# Model ID for the AI Environmental Copilot.
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ─── DynamoDB Table Names ──────────────────────────────────────────────────────
DYNAMODB_TABLE_TELEMETRY=aeris-telemetry
DYNAMODB_TABLE_FORECASTS=aeris-forecasts
DYNAMODB_TABLE_ANOMALIES=aeris-anomalies
